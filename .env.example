# Supabase Dashboard > Project Settings > API から取得します。
# anon key は公開可能ですが、service_role key は NEXT_PUBLIC_ 変数に設定しないでください。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Stripe Webhookから契約状態を反映するサーバー専用鍵です。NEXT_PUBLIC_を付けないでください。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI説明はサーバー側だけで実行します。ブラウザへ公開しないでください。
AI_GATEWAY_API_KEY=your-ai-gateway-key
# provider/modelを変更するときだけ上書きします。
LIFEATLAS_AI_MODEL=openai/gpt-5.6-luna
LIFEATLAS_FREE_AI_DAILY_LIMIT=3
LIFEATLAS_PRO_AI_DAILY_LIMIT=100

# Stripeの値はすべてサーバー専用です。実鍵はリポジトリへ保存しないでください。
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-signing-secret
STRIPE_PRO_MONTHLY_PRICE_ID=price_your-monthly-price
STRIPE_PRO_ANNUAL_PRICE_ID=price_your-annual-price
